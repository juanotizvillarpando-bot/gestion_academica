{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sistema Gestión Académica (Web)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/GestionAcademica.Api/bin/Debug/net10.0/GestionAcademica.Api.dll",
      "args": ["--urls", "http://localhost:5000"],
      "cwd": "${workspaceFolder}/GestionAcademica.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}

